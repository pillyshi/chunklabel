# cp .env.example .env, then edit. .env is gitignored.

# ssh destination: an ~/.ssh/config alias, a host, or user@host
HOST=192.168.0.12

# Remote project directory (relative to the remote home). Defaults to this
# directory's name.
# REMOTE_DIR=chunklabel

# Used by install-llama-cpp. LLAMA_CPP_VERSION must match uv.lock.
# CUDA_VERSION=12.8
# GCC_VERSION=13
# LLAMA_CPP_VERSION=0.3.28
